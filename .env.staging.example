# Copy to .env.staging on the staging host. Never commit the filled file.
APP_ENV=staging
APP_MODE=DRY_RUN
PUBLICATION_MODE=DRY_RUN
HUNTER_OUTBOUND_DISABLED=true
TELEGRAM_REAL_SEND_ENABLED=false
TELEGRAM_REAL_CONNECT_ENABLED=false
TELEGRAM_DISCOVERY_ENABLED=false
TELEGRAM_HISTORY_SYNC_ENABLED=false
TELEGRAM_LIVE_READ_ENABLED=false

STAGING_PUBLIC_URL=https://staging.example.invalid
STAGING_HOST=staging.example.invalid
STAGING_RELEASE_TAG=core-r1-staging-rc1-2026-09-07
STAGING_BUILD_ID=core-r1-staging-rc1-2026-09-07

STAGING_POSTGRES_USER=core_staging
STAGING_POSTGRES_PASSWORD=replace-in-secret-store
STAGING_POSTGRES_DB=core_staging
STAGING_JWT_SECRET=replace-in-secret-store
STAGING_DATABASE_URL=postgresql+psycopg://core_staging:replace-in-secret-store@db:5432/core_staging
STAGING_REDIS_URL=redis://redis:6379/0
STAGING_CORS_ORIGINS=https://staging.example.invalid

# Staging-only storage and logging locations.
STAGING_ARTIFACT_ROOT=/app/.core_artifacts
STAGING_LOG_LEVEL=INFO
